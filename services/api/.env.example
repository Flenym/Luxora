NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=./data/luxora.db
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Empty means direct deployment: forwarding headers are ignored. Behind an
# ingress, list only its exact source CIDRs; never use a catch-all range.
TRUSTED_PROXY_CIDRS=
# Internal passkey route gates are development/test only and never change the
# advertised public capability. Signup is independently gated and fails startup
# unless its authorization root, rotated refresh keyring/active ID and active
# data-encryption key are all present. Authorization and every retained signup
# refresh root must be unique and must not reuse JWT/login-refresh/data material.
PASSKEY_INTERNAL_ROUTES_ENABLED=false
PASSKEY_INTERNAL_SIGNUP_ROUTES_ENABLED=false
# PASSKEY_BOOTSTRAP_REFRESH_KEYS={"login.2026-08.v1":"replace-with-32-byte-base64url-key"}
# ACTIVE_PASSKEY_BOOTSTRAP_REFRESH_KEY_ID=login.2026-08.v1
# PASSKEY_SIGNUP_AUTHORIZATION_SECRET=replace-with-an-independent-32-byte-secret
# PASSKEY_SIGNUP_REFRESH_KEYS={"signup.2026-08.v1":"replace-with-a-distinct-32-byte-base64url-key"}
# ACTIVE_PASSKEY_SIGNUP_REFRESH_KEY_ID=signup.2026-08.v1
# Required in production. Values are base64url-encoded 32-byte AES keys; retain old keys during rotation.
# DATA_ENCRYPTION_KEYS={"2026-08":"replace-with-base64url-key"}
# ACTIVE_DATA_ENCRYPTION_KEY_ID=2026-08
# Phone authentication is disabled by default. Enabling it also requires the
# active data-encryption key above and independent HMAC material. The
# development provider is local/test-only and is rejected in production. The
# external provider requires an implementation injected by the application;
# environment configuration alone deliberately fails closed.
# PHONE_AUTH_ENABLED=false
# PHONE_AUTH_PROVIDER=disabled
# PHONE_AUTH_HMAC_SECRET=replace-with-an-independent-random-secret-of-at-least-32-bytes
# PHONE_AUTH_DEVELOPMENT_CODE=000000
# PHONE_AUTH_CHALLENGE_TTL_SECONDS=300
# PHONE_AUTH_REGISTRATION_TTL_SECONDS=600
# PHONE_AUTH_RETRY_AFTER_SECONDS=60
# PHONE_AUTH_MAX_ATTEMPTS=5
# Upload and object storage. Local blobs and resumable staging chunks use AES-GCM when the keyring is configured.
# Beta-0.1 validates hashes/MIME but deliberately reports uploads as unscanned; malware scanning and transcoding are not implemented.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/blobs
UPLOAD_STAGING_PATH=./data/uploads
MAX_ATTACHMENT_BYTES=104857600
USER_STORAGE_QUOTA_BYTES=1073741824
UPLOAD_CHUNK_SIZE_BYTES=1048576
UPLOAD_SESSION_TTL_MINUTES=60
ORPHAN_ATTACHMENT_TTL_HOURS=24
# S3-compatible alternative (credentials use the standard AWS provider chain):
# STORAGE_DRIVER=s3
# S3_BUCKET=luxora-media
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false
# S3_SERVER_SIDE_ENCRYPTION=aws:kms
# S3_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/00000000-0000-0000-0000-000000000000
# Deployment prerequisite: apply s3-health-lifecycle.example.json (or an equivalent rule) to expire
# current objects, noncurrent versions, and delete markers below attachments/.health/. The app cannot
# configure bucket lifecycle and readiness alone cannot guarantee lifecycle enforcement.
# Multi-replica deployment must migrate the single-node canary to per-instance keys plus version cleanup.
# Set to protect /metrics. When omitted, metrics bind to the service network without auth.
# METRICS_TOKEN=
