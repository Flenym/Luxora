{
  "name": "@luxora/api",
  "version": "0.1.0",
  "description": "Luxora Beta-0.1 HTTP and realtime messaging API",
  "author": "Flenym",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.0.1",
    "@luxora/passkey-domain": "file:../../packages/passkey-domain",
    "@luxora/protocol": "file:../../packages/protocol",
    "@luxora/call-control": "file:../../packages/call-control",
    "@simplewebauthn/server": "13.3.2",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "file-type": "^22.0.1",
    "jose": "^6.0.8",
    "libphonenumber-js": "1.13.10",
    "sharp": "0.35.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "ws": "^8.18.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
