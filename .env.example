# Local Docker Compose configuration only. Never commit the copied .env file.
NODE_ENV=development
# The container always listens on 8080; this changes only the loopback host port.
LUXORA_API_HOST_PORT=8080
# Loopback-only development OTP console. It starts only through the explicit
# Compose `development` profile and refuses non-development phone providers.
LUXORA_OTP_CONSOLE_HOST_PORT=8081
DATABASE_PATH=/app/data/luxora.db
# Intentionally invalid so an unchanged example cannot start the API.
# Generate a local value out of band, for example: openssl rand -hex 32
JWT_SECRET=replace-me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Empty means direct deployment: forwarding headers are ignored. Behind an
# ingress, list only its exact source CIDRs; never use a catch-all range.
TRUSTED_PROXY_CIDRS=

# Development/test integration seam only. Production rejects true and the
# public passkey capability remains disabled until the complete identity flow
# and its release evidence exist.
PASSKEY_INTERNAL_ROUTES_ENABLED=false

# Phone-first authentication is fail-closed by default. Production may use
# only an injected external delivery provider. The development provider is for
# local Xcode/Docker evidence, never for a deployed environment, and requires
# both a dedicated HMAC root and the active DATA_ENCRYPTION key below.
PHONE_AUTH_ENABLED=false
PHONE_AUTH_PROVIDER=disabled
# PHONE_AUTH_HMAC_SECRET=replace-with-an-independent-32-byte-secret
# PHONE_AUTH_DEVELOPMENT_CODE=replace-with-six-digits
PHONE_AUTH_CHALLENGE_TTL_SECONDS=300
PHONE_AUTH_REGISTRATION_TTL_SECONDS=600
PHONE_AUTH_RETRY_AFTER_SECONDS=60
PHONE_AUTH_MAX_ATTEMPTS=5
# Deliberate confirmation window before a forgotten phone password can be reset.
# Production requires >= 3600 seconds.
PHONE_AUTH_RECOVERY_DELAY_SECONDS=300
PHONE_AUTH_RECOVERY_TTL_SECONDS=86400

# Emergency rollback seam only. The default-on path emits and delivers
# `sync.invalidated`; false suppresses only that event and advertises the
# degraded capability. It does not roll back migrations or domain events.
SYNC_INVALIDATION_ENABLED=true

# Independent pre-account signup seam. Production rejects true. Enabling it
# requires all three dedicated signup variables below plus the active
# DATA_ENCRYPTION key; partial configuration fails startup. Never reuse JWT,
# authorization, signup-refresh, login-refresh or data-encryption material:
# every raw signup root, including retained rotation entries, must be unique.
PASSKEY_INTERNAL_SIGNUP_ROUTES_ENABLED=false
# PASSKEY_SIGNUP_AUTHORIZATION_SECRET=replace-with-an-independent-32-byte-secret
# PASSKEY_SIGNUP_REFRESH_KEYS={"signup.2026-08.v1":"replace-with-a-distinct-32-byte-base64url-key"}
# ACTIVE_PASSKEY_SIGNUP_REFRESH_KEY_ID=signup.2026-08.v1

# Separate rotation roots for deterministic first-login refresh recovery. With
# the internal flag above, both variables and an active DATA_ENCRYPTION key wire
# the identifier-free primary-login route pair; a partial setup fails closed.
# Retain old keys until every response-loss recovery window and issued session
# has elapsed. These do not replace DATA_ENCRYPTION_KEYS.
# PASSKEY_BOOTSTRAP_REFRESH_KEYS={"2026-08.v1":"replace-with-32-byte-base64url-key"}
# ACTIVE_PASSKEY_BOOTSTRAP_REFRESH_KEY_ID=2026-08.v1

# Every runnable development/production API requires a real 32-byte base64url
# AES key and an active key ID. Generate outside the repository (for example,
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`) and inject it through
# the local uncommitted .env or deployment secret store.
# DATA_ENCRYPTION_KEYS={"2026-08":"replace-with-base64url-key"}
# ACTIVE_DATA_ENCRYPTION_KEY_ID=2026-08

# Optional bearer token for /metrics. The supplied local Prometheus profile
# assumes this is unset; enabling it also requires a non-committed Prometheus
# credentials file/configuration.
# METRICS_TOKEN=

# Optional operator token for the read-only local admin surface
# (/v1/admin/status, /v1/admin/users, /v1/admin/chats). At least 32
# characters; without it the surface answers 503. Never commit the real
# value; the Windows preview (start.bat) generates and stores its own copy
# in the ignored data/luxora-server.env.
# ADMIN_TOKEN=
