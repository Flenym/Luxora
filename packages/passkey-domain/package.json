{
  "name": "@luxora/passkey-domain",
  "version": "0.1.0",
  "description": "Isolated WebAuthn ceremony orchestration domain for Luxora Beta-0.1",
  "author": "Flenym",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "fast-check": "^4.9.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
