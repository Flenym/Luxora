# Copy to infra/calls/.env.calls and replace every value before starting.
# The destination is ignored by the repository's .env.* rule.
LIVEKIT_API_KEY=luxora_local_key
LIVEKIT_API_SECRET=replace_with_at_least_32_url_safe_random_characters
TURN_SHARED_SECRET=replace_with_at_least_32_url_safe_random_characters

# Loopback defaults are for a Simulator/browser on the same Mac only.
CALLS_NODE_IP=172.31.80.10
TURN_PUBLIC_HOST=127.0.0.1
TURN_PUBLIC_IP=127.0.0.1
TURN_PORT=3478
TURN_REALM=calls.luxora.local

