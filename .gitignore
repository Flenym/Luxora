# The checked-in Luxora iOS project is source, not DerivedData. Keep only its
# shared project/workspace metadata; per-user Xcode state remains ignored.
!apps/apple/Luxora.xcodeproj/
!apps/apple/Luxora.xcodeproj/project.pbxproj
!apps/apple/Luxora.xcodeproj/project.xcworkspace/
!apps/apple/Luxora.xcodeproj/project.xcworkspace/contents.xcworkspacedata

